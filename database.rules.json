{
  "rules": {
    ".read": false,
    ".write": false,

    "cache": {
      ".indexOn": "expires_at"
    },

    "users": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",

        "rewards": {
          ".indexOn": ["purgeAt", "expiresAt"],

          "$rewardId": {
            ".write": "auth !== null && auth.uid === $uid && newData.exists()",

            ".validate": "newData.hasChildren(['amount', 'balance', 'type', 'createdAt', 'expiresAt', 'purgeAt'])",

            // Free grants are tiny — a clock-in is at most 4, the starter pack 10 — so 100 is
            // generous headroom for a promotion while making the old blanket 100000 ceiling
            // useless for minting. Purchases keep the high ceiling only for as long as clients
            // still write them; see the type rule below.
            "amount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.parent().child('type').val() === 'purchase' ? newData.val() <= 100000 : newData.val() <= 100)"
            },
            "balance": {
              ".validate": "newData.isNumber() && newData.val() <= 100000"
            },
            // STEP 3 of the purchase rollout. Once /api/wallet/purchase is live and the app
            // release that calls it has adoption, change this to reject 'purchase' from any
            // client — that is what finally stops coins being minted. Server writes go through
            // the Admin SDK and bypass rules, so crediting keeps working. Deploying it early
            // would break every handset still crediting locally: they would pay and get nothing.
            "type": {
              ".validate": "newData.isString() && (newData.val() !== 'purchase' || auth.token.firebase.sign_in_provider !== 'anonymous')"
            },
            "description": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "createdAt": { ".validate": "newData.isNumber()" },
            "expiresAt": { ".validate": "newData.isNumber()" },
            "purgeAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "spends": {
          ".indexOn": ["purgeAt"],

          "$spendId": {
            ".write": "auth !== null && auth.uid === $uid && newData.exists()",

            ".validate": "newData.hasChildren(['amount', 'type', 'createdAt', 'purgeAt'])",

            "amount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "type": { ".validate": "newData.isString()" },
            "description": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "rewards": {
              "$rewardId": { ".validate": "newData.isBoolean()" }
            },
            "createdAt": { ".validate": "newData.isNumber()" },
            "purgeAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "currencies": {
          "$code": {
            ".write": "auth !== null && auth.uid === $uid",

            ".validate": "!newData.exists() || newData.hasChildren(['rate'])",

            "rate": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "lastRate": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "url": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "lastChecked": { ".validate": "newData.isNumber()" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "sortOrder": { ".validate": "newData.isNumber()" },
            "pinned": { ".validate": "newData.isBoolean()" },
            "hidden": { ".validate": "newData.isBoolean()" },
            "custom": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
