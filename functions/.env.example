# Apify — page fetching
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APIFY_ACTOR_ID=tyganeutronics~zimrate-page-fetcher

# LLMs used to extract rates from fetched pages, via the official `openai` SDK,
# through the LiteLLM proxy. The models must support tool calling and
# response_format: { type: 'json_object' }.
#
# LLM_MODELS is a comma-separated list of LiteLLM model names, in the order to
# try them: each later model reruns the extraction only when the ones before it
# fail (outage, quota, invalid JSON).
#
# LLM_API_URL accepts either the base URL or the full chat-completions path;
# the trailing /chat/completions is stripped for the SDK either way.
#
# List free models first so paid ones only run as a fallback.
#
# Pin a dated model name rather than a *-latest alias: a silent model swap can
# reword rate labels, and a reworded label reads as a different rate.
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx
LLM_API_URL=https://llm-router.tyganeutronics.com
LLM_MODELS=gemini/gemini-3.5-flash-lite,deepseek-flash

# App Check enforcement on /api/admin/**. Leave unset while rolling out.
APPCHECK_ENFORCE=false

# Server-side GA4, via the Measurement Protocol — logs an api_request event per
# /api call. Both must be set or the middleware is a no-op.
#
# MEASUREMENT_ID must be the same property the browser tag in
# hosting/index.html reports to, or API traffic lands in a separate property.
#
# The API secret is scoped to that property's data stream — it is NOT
# interchangeable between properties. Create one under
# GA Admin > Data Streams > (stream) > Measurement Protocol API secrets.
# A mismatched pair fails silently: the endpoint returns success regardless and
# the request is fire-and-forget, so nothing surfaces in logs.
MEASUREMENT_ID=G-XXXXXXXXXX
MEASUREMENT_PROTOCOL_API_SECRET=

# Salts the hash used as the GA4 client_id, so it cannot be reversed back to a
# caller's IP. Any long random string: `openssl rand -hex 24`.
# Optional — if unset, a random salt is generated per instance, which splits one
# caller across cold starts and inflates user counts. Set it in production.
# Changing it resets every caller's identity, so treat it as permanent.
ANALYTICS_SALT=
