# Copy to .env.local for developer-specific overrides.
# Everything here is public (shipped in the client bundle) — never put secrets in a VITE_ var.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Empty = same origin (hosting rewrite in prod, vite proxy in dev)
VITE_API_BASE_URL=
# Origin shown in copyable API examples. Empty = window.location.origin
VITE_PUBLIC_API_ORIGIN=

# App Check. Empty site key disables App Check entirely.
VITE_RECAPTCHA_SITE_KEY=
# Register this token under App Check > Apps > Manage debug tokens to reuse it across restarts.
VITE_APPCHECK_DEBUG_TOKEN=

